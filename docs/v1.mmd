%% AQP — AI News as a Quantitative Exogenous Feature
%% Architecture proposal derived from AQP OVERVIEW(2).md.
%% Core rule: compare each no-news baseline with its matched news-augmented challenger.

flowchart TB

    %% -------------------- FOUNDATION --------------------
    subgraph FOUNDATION["STAGE 00–01 · POINT-IN-TIME DATA AND UNIVERSE FOUNDATION"]
        direction TB
        RUN["Run configuration<br/>Decision cutoff · horizon · sleeve · universe version"]
        DATA["Validated source data<br/>Prices / trades / quotes · company fundamentals<br/>Macro releases and vintages · identifiers · calendars"]
        ASOF["Point-in-time snapshot X(t)<br/>Only information available by the decision cutoff<br/>Versioned features · source lineage · quality flags"]
        RUN --> DATA --> ASOF
    end

    %% -------------------- NEWS FEATURE ENGINE --------------------
    subgraph NEWS_ENGINE["STAGE 02D · AI NEWS → QUANTITATIVE EXOGENOUS VARIABLES"]
        direction TB
        RAW["Timestamped qualitative sources<br/>News · filings · transcripts · exchange announcements<br/>Publication time and source metadata"]
        TIME{"Source, timestamp,<br/>model version and as-of checks pass?"}
        LINK["Deduplicate stories and link entities<br/>Security · firm · sector · industry · geography<br/>Macro topic · event relationship graph"]
        NLP["NLP / LLM structured extraction<br/>Fixed schema; evidence spans; prompt/model version frozen"]
        QUANT["Convert qualitative content to quantitative fields<br/>Event/topic probabilities · direction / sentiment<br/>Novelty / residual surprise · severity / magnitude<br/>Source credibility · extraction confidence"]
        DYNAMICS["Build time-dependent news features<br/>Event-response probability · persistence / decay<br/>Exposure-weighted firm / sector / macro aggregates<br/>Latency-aware aggregation and propagation"]
        QC{"News feature schema,<br/>timestamps and quality checks pass?"}
        Z["Versioned quantitative news covariates Z(t)<br/>As-of timestamp · entity mapping · confidence / coverage<br/>Missingness flags · source lineage · NLP model / prompt version<br/>Predictive inputs; not assumed causal by default"]
        NFAIL["Quarantine or mark news unavailable<br/>Log reason code; never silently replace missing news with zero"]

        RAW --> TIME
        TIME -->|Pass| LINK --> NLP --> QUANT --> DYNAMICS --> QC
        TIME -->|Fail| NFAIL
        QC -->|Pass| Z
        QC -->|Fail| NFAIL
    end

    DATA --> RAW
    ASOF --> TIME

    %% -------------------- EXPERIMENTAL DESIGN --------------------
    subgraph EXPERIMENT["CONTROLLED EXPERIMENT · SAME UNIVERSE, TARGETS AND WALK-FORWARD FOLDS"]
        direction LR

        subgraph CONTROL["ARM A · ORIGINAL MODELS / NO NEWS"]
            direction TB
            F0["Financial baseline<br/>Core financial features only"]
            M0["Macroeconomic baseline<br/>Core macro features only"]
            U0["Firm / microstructure baseline<br/>Core firm, peer and market features only"]
        end

        subgraph CHALLENGER["ARM B · MATCHED MODELS + NEWS FEATURES"]
            direction TB
            F1["Financial challenger<br/>Core financial features + Z(t)"]
            M1["Macroeconomic challenger<br/>Core macro features + Z(t)"]
            U1["Firm / microstructure challenger<br/>Core firm, peer and market features + Z(t)"]
        end
    end

    ASOF --> F0
    ASOF --> M0
    ASOF --> U0
    ASOF --> F1
    ASOF --> M1
    ASOF --> U1

    Z --> F1
    Z --> M1
    Z --> U1

    %% -------------------- MATCHED FORECASTS AND BENCHMARKING --------------------
    F0 --> BASEOUT["No-news baseline forecasts"]
    M0 --> BASEOUT
    U0 --> BASEOUT

    F1 --> NEWSOUT["News-augmented challenger forecasts"]
    M1 --> NEWSOUT
    U1 --> NEWSOUT

    BASEOUT --> CONTRACT["Common forecast contract<br/>Same target and horizon · decision timestamp<br/>Quantiles / uncertainty · security or aggregate key<br/>Model version · training window · feature lineage"]
    NEWSOUT --> CONTRACT

    CONTRACT --> MATCH["Pair forecasts by model family and test observation<br/>Same universe, decision times, labels, horizons and folds<br/>Matched model family and tuning budget; only Z(t) differs<br/>Same evaluation protocol and cost assumptions"]
    MATCH --> EVAL["Out-of-sample paired evaluation<br/>Forecast loss / quantile score · calibration / coverage<br/>Direction and event-risk scores where appropriate<br/>Stability by regime, horizon and entity group<br/>Net-of-cost backtest · turnover and drawdown"]
    EVAL --> STATS["Estimate incremental value of news<br/>Paired loss differences · uncertainty / block bootstrap<br/>Multiple-testing control · ablation and sensitivity checks"]
    STATS --> G3{"G3 · Does the news challenger<br/>show robust incremental value?"}

    G3 -->|No / inconclusive| RETAIN["Retain the no-news baseline / current approved model<br/>Log result and reason; revise only through a new trial"]
    G3 -->|Yes| SHADOW["Eligible challenger → shadow evaluation<br/>Confirm live-timing, latency, calibration and stability"]
    SHADOW --> PROMOTE{"Promotion criteria and<br/>independent approval pass?"}
    PROMOTE -->|No| RETAIN
    PROMOTE -->|Yes| ELIGIBLE["Versioned approved model<br/>News features used only under validated coverage and policy"]

    NFAIL -.->|News unavailable| NOTE["Baseline remains evaluable on its full sample<br/>Paired test uses shared observations or a preregistered<br/>missingness policy; report coverage; never silently zero-fill"]

    %% -------------------- GOVERNED DOWNSTREAM PIPELINE --------------------
    ELIGIBLE --> COMMON["Eligible forecast set<br/>Baseline and/or approved challenger outputs"]
    RETAIN --> COMMON
    COMMON --> COMBINE["Stage 02E · Validation and forecast combination<br/>Only eligible forecasts receive combination weight"]
    COMBINE --> PORT["Stages 03–04 · Risk and portfolio construction<br/>Covariance / tail risk · stress · cost-aware optimisation"]
    PORT --> SAFE["Stages 05–06 · Sizing and independent controls<br/>Leverage / margin · no-trade checks · execution limits"]
    SAFE --> MON["Stage 07 · Monitoring and reporting<br/>Forecast drift · news-feature drift · latency · P&L / costs<br/>Plots · run manifest · reason codes · reproducible reports"]

    %% -------------------- STYLES --------------------
    classDef foundation fill:#eaf2f8,stroke:#477b9e,color:#19364a,stroke-width:1px;
    classDef news fill:#eee9fb,stroke:#7762a8,color:#30244f,stroke-width:1px;
    classDef baseline fill:#f3f4f6,stroke:#6b7280,color:#202938,stroke-width:1px;
    classDef challenger fill:#edf7ed,stroke:#54845e,color:#1d4026,stroke-width:1px;
    classDef gate fill:#fff2d9,stroke:#b9862b,color:#593c0c,stroke-width:1.5px;
    classDef stop fill:#fce8e6,stroke:#b3261e,color:#5f1410,stroke-width:1px;
    classDef process fill:#eaf2f8,stroke:#477b9e,color:#19364a,stroke-width:1px;
    classDef approved fill:#e3f3e5,stroke:#2f7a43,color:#174923,stroke-width:1.5px;

    class RUN,DATA,ASOF foundation;
    class RAW,LINK,NLP,QUANT,DYNAMICS,Z news;
    class TIME,QC,G3,PROMOTE gate;
    class NFAIL stop;
    class F0,M0,U0,BASEOUT baseline;
    class F1,M1,U1,NEWSOUT,SHADOW challenger;
    class CONTRACT,MATCH,EVAL,STATS,NOTE,COMMON,COMBINE,PORT,SAFE,MON process;
    class ELIGIBLE approved;
    class RETAIN baseline;
